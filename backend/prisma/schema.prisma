// ─── Change 1: ExecutionType enum ────────────────────────────────────────────

enum ExecutionType {
  inhouse
  outsourced
}

// ─── Change 1: Machine model ─────────────────────────────────────────────────

model Machine {
  id             String       @id @default(uuid())
  organizationId String
  machineCode    String       @unique
  machineName    String
  machineType    String
  department     String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  jobProcesses   JobProcess[]
}

// ─── Change 2: DevStage enum ─────────────────────────────────────────────────

enum DevStage {
  drawing_shared
  sample_submitted
  first_article_inspection
  approved
  rejected
}

// ─── Change 2: PartDevelopment model ─────────────────────────────────────────

model PartDevelopment {
  id              String                   @id @default(uuid())
  organizationId  String
  partId          String
  vendorId        String
  stage           DevStage                 @default(drawing_shared)
  drawingVersion  String?
  drawingUrl      String?
  targetDate      DateTime?
  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?
  remarks         String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  organization    Organization             @relation(fields: [organizationId], references: [id])
  part            Part                     @relation(fields: [partId], references: [id])
  vendor          Vendor                   @relation(fields: [vendorId], references: [id])
  approvedBy      User?                    @relation("DevelopmentApprover", fields: [approvedById], references: [id])
  faiRecords      FirstArticleInspection[]
}

// ─── Change 3: CustomerOrderStatus enum ──────────────────────────────────────

enum CustomerOrderStatus {
  active
  completed
  cancelled
  on_hold
}

// ─── Change 3: CustomerOrder and CustomerOrderItem models ────────────────────

model CustomerOrder {
  id             String              @id @default(uuid())
  organizationId String
  customerId     String
  orderNumber    String              @unique
  customerPoRef  String?
  orderDate      DateTime
  deliveryDate   DateTime?
  remarks        String?
  status         CustomerOrderStatus @default(active)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id])
  customer       Customer            @relation(fields: [customerId], references: [id])
  items          CustomerOrderItem[]
}

model CustomerOrderItem {
  id              String        @id @default(uuid())
  orderId         String
  partNumber      String
  customerPartNo  String?
  partDescription String?
  quantity        Int
  deliveredQty    Int           @default(0)
  pendingQty      Int
  unitPrice       Float?
  deliveryDate    DateTime?
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([partNumber])
  @@index([orderId])
}

// ─── Change 5: ReceiptStatus enum ────────────────────────────────────────────

enum ReceiptStatus {
  pending_inspection
  inspected
  accepted
  partially_accepted
  rejected
}

// ─── Change 5: MaterialReceipt and MaterialReceiptItem models ─────────────────

model MaterialReceipt {
  id             String                 @id @default(uuid())
  organizationId String
  receiptNumber  String                 @unique
  receiptDate    DateTime
  vendorId       String
  dispatchPlanId String?
  vehicleNumber  String?
  driverName     String?
  receivedById   String
  status         ReceiptStatus          @default(pending_inspection)
  remarks        String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id])
  vendor         Vendor                 @relation(fields: [vendorId], references: [id])
  dispatchPlan   DispatchPlan?          @relation(fields: [dispatchPlanId], references: [id])
  receivedBy     User                   @relation("GateReceipts", fields: [receivedById], references: [id])
  items          MaterialReceiptItem[]
  ledgerEntries  VendorMaterialLedger[]
}

model MaterialReceiptItem {
  id             String          @id @default(uuid())
  receiptId      String
  challanItemId  String
  expectedQty    Int
  receivedQty    Int
  shortQty       Int             @default(0)
  excessQty      Int             @default(0)
  rejectedAtGate Int             @default(0)
  remarks        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  receipt        MaterialReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  challanItem    ChallanItem     @relation(fields: [challanItemId], references: [id])
}

// ─── Change 6: LedgerEntryType enum ──────────────────────────────────────────

enum LedgerEntryType {
  material_issued
  material_returned
  rejected_returned
  adjustment
}

// ─── Change 6: VendorMaterialLedger model ────────────────────────────────────

model VendorMaterialLedger {
  id             String           @id @default(uuid())
  organizationId String
  vendorId       String
  partNumber     String
  entryType      LedgerEntryType
  challanId      String?
  receiptId      String?
  quantity       Int
  balanceAfter   Int
  remarks        String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id])
  vendor         Vendor           @relation(fields: [vendorId], references: [id])
  challan        DeliveryChallan? @relation(fields: [challanId], references: [id])
  receipt        MaterialReceipt? @relation(fields: [receiptId], references: [id])

  @@index([organizationId, vendorId, partNumber])
}

model PlatformAuditLog {
  id             String        @id @default(uuid())
  action         String
  adminId        String
  organizationId String?
  details        String?
  createdAt      DateTime      @default(now())
  admin          User          @relation("PlatformActionBy", fields: [adminId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

// ─── Platform-wide key-value settings (e.g. ANTHROPIC_API_KEY) ──────────────
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Gate Pass (Security module) ─────────────────────────────────────────────

enum GatePassStatus {
  active
  closed
  overstay
}

model GatePass {
  id             String         @id @default(uuid())
  passNumber     String         @unique
  organizationId String
  visitorName    String
  visitorPhone   String?
  visitorCompany String?
  idProofType    String?
  idProofNumber  String?
  purpose        String
  personToMeet   String?
  vehicleNumber  String?
  entryTime      DateTime       @default(now())
  exitTime       DateTime?
  status         GatePassStatus @default(active)
  remarks        String?
  issuedById     String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id])
  issuedBy       User           @relation("GatePassIssuedBy", fields: [issuedById], references: [id])
}

// ─── Supplier GRN (Goods Receipt Note from Supplier) ─────────────────────────
// Tracks castings/forgings received from suppliers against POs.
// This fills the blind spot: Supplier → OEM Store → Vendor (challan).

enum GRNStatus {
  draft
  received
  inspected
}

model SupplierGRN {
  id             String    @id @default(uuid())
  organizationId String
  grnNumber      String    @unique
  grnDate        DateTime
  supplierId     String
  poId           String?
  vehicleNumber  String?
  driverName     String?
  driverPhone    String?
  invoiceNumber  String? // supplier's DC/invoice number
  remarks        String?
  status         GRNStatus @default(draft)
  receivedById   String
  inspectedById  String?
  inspectedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id])
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?    @relation(fields: [poId], references: [id])
  receivedBy    User              @relation("GRNReceivedBy", fields: [receivedById], references: [id])
  inspectedBy   User?             @relation("GRNInspectedBy", fields: [inspectedById], references: [id])
  items         SupplierGRNItem[]

  @@index([organizationId, supplierId])
  @@index([organizationId, grnDate])
}

model SupplierGRNItem {
  id              String   @id @default(uuid())
  grnId           String
  poItemId        String?
  partNumber      String
  partDescription String?
  expectedQty     Int      @default(0)
  receivedQty     Int
  rejectedQty     Int      @default(0)
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  grn    SupplierGRN @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem POItem?     @relation(fields: [poItemId], references: [id])

  @@index([grnId])
  @@index([partNumber])
}

// ─── LineDeadline: Monthly line-wise targets per customer + part ──────────────

model LineDeadline {
  id               String   @id @default(uuid())
  organizationId   String
  customerId       String
  partNumber       String
  month            Int // 1–12
  year             Int
  monthlyTarget    Int      @default(0)
  week1Target      Int      @default(0)
  week2Target      Int      @default(0)
  week3Target      Int      @default(0)
  week4Target      Int      @default(0)
  readyForDispatch Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@unique([organizationId, customerId, partNumber, month, year])
  @@index([organizationId, month, year])
  @@index([customerId])
}

// ─── AiConversation: Persistent multi-turn chat history per user ──────────────

model AiConversation {
  id        String   @id @default(uuid())
  userId    String
  role      String // 'user' | 'assistant'
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── AI Knowledge Center ──────────────────────────────────────────────────────
// Admins enter structured business context about customers, vendors, parts, etc.
// This knowledge is injected into every JARVIS system prompt.

enum KnowledgeCategory {
  customer_profile
  vendor_profile
  part_profile
  business_rule
  sop
  company_context
}

model KnowledgeItem {
  id             String            @id @default(uuid())
  organizationId String
  category       KnowledgeCategory
  title          String
  content        String            @db.Text
  tags           String[]
  visibleToRoles String[]          // empty = visible to all internal roles
  isActive       Boolean           @default(true)
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation("KnowledgeCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, category])
  @@index([organizationId, isActive])
}

// ─── AI Feedback: thumbs up/down on JARVIS chat responses ────────────────────

model AiFeedback {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  query          String   @db.Text
  response       String   @db.Text
  rating         Int      // 1 = thumbs up, -1 = thumbs down
  reason         String?  // 'wrong_data' | 'not_useful' | 'missed_context' | 'other'
  comment        String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation("AiFeedbackUser", fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}
